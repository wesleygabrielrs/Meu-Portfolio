# Variáveis de ambiente (não comitar no GitHub)
SECRET_KEY=sua-chave-secreta-aqui

# Configuração de e-mail (ver README para instruções)
# Opção 1 — Gmail (precisa de "Senha de App")
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua-senha-de-app

# Opção 2 — SendGrid (gratuito: 100 e-mails/dia)
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SEU_SENDGRID_API_KEY

# Para onde enviar os e-mails do formulário
MAIL_DESTINO=seuemail@gmail.com